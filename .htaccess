# Enable Brotli (if available) and Deflate compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Ensure proxies/cache vary on encoding
<IfModule mod_headers.c>
  Header append Vary "Accept-Encoding"
</IfModule>

# Disable ETags (optional)
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# Caching rules
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Cache static assets aggressively (immutable)
  <FilesMatch "\.(?:css|js|png|jpg|jpeg|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  # HTML should be revalidated
  <FilesMatch "\.(?:html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Small performance/security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
